# Copy to .env and adjust: `cp .env.example .env`
# .env is git-ignored. Never commit real secrets.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=appcasa
POSTGRES_PASSWORD=appcasa
POSTGRES_DB=appcasa
POSTGRES_PORT=5432

# --- Prisma ---
DATABASE_URL=postgresql://appcasa:appcasa@localhost:5432/appcasa?schema=public

# --- Auth secrets (ADR-0008) ---
# Not committed: generate your own and append them to .env:
#   pnpm --silent keys:generate >> .env
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# VERIFICATION_CODE_SECRET=<at least 32 random characters>

# --- Mail (ADR-0009). Locally, Mailpit from docker-compose ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM="AppCasa <no-reply@appcasa.local>"
